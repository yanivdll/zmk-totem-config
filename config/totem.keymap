//
//                                                        ▀▀▀▀▀     ▀▀▀▀▀          ▀▀█▀▀
//                                                        ▄▀▀▀▄  ▄  ▄▀▀▀▄  ▄  ▄▀▀▀▄  █  ▄▀▀▀▄
//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define NAV  1
#define SYM  2
#define ADJ  3

&mt {
    quick-tap-ms = <100>;
    global-quick-tap;
    flavor = "tap-preferred";
    tapping-term-ms = <200>;
};

/ {
    combos {
        compatible = "zmk,combos";

        Escape {
            bindings = <&kp ESCAPE>;
            key-positions = <13 16>;
            layers = <0>;
        };

        L_Command {
            bindings = <&kp LEFT_COMMAND>;
            key-positions = <12 13>;
            layers = <0>;
        };

        R_Command {
            bindings = <&kp RIGHT_COMMAND>;
            key-positions = <17 16>;
            layers = <0>;
        };

        L_CTRL {
            bindings = <&kp LEFT_CONTROL>;
            key-positions = <11 12>;
            layers = <0>;
        };

        R_CTRL {
            bindings = <&kp RIGHT_CONTROL>;
            key-positions = <17 18>;
            layers = <0>;
        };

        L_ALT {
            bindings = <&kp LEFT_ALT>;
            key-positions = <11 10>;
            layers = <0>;
        };

        R_ALT {
            bindings = <&kp RIGHT_ALT>;
            key-positions = <18 19>;
            layers = <0>;
        };

        nav_layer3 {
            bindings = <&mo 3>;
            key-positions = <33 13>;
            slow-release;
            timeout-ms = <120>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        nav_layer5 {
            bindings = <&mo 5>;
            key-positions = <36 16>;
            slow-release;
            timeout-ms = <120>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        nav_layer4 {
            bindings = <&mo 4>;
            key-positions = <33 12>;
            slow-release;
            timeout-ms = <120>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        nav_layer6 {
            bindings = <&mo 6>;
            key-positions = <17 36>;
            slow-release;
            timeout-ms = <120>;
            require-prior-idle-ms = <100>;
            layers = <0>;
        };

        nav_layer8 {
            bindings = <&mo 8>;
            key-positions = <32 37>;
        };

        nav_layer1 {
            bindings = <&mo 1>;
            key-positions = <14 33>;
            slow-release;
            timeout-ms = <120>;
            require-prior-idle-ms = <100>;
        };

        nav_layer2 {
            bindings = <&mo 2>;
            key-positions = <15 36>;
            slow-release;
            timeout-ms = <120>;
            require-prior-idle-ms = <100>;
        };
    };

    macros {
        gif: gif {
            label = "giphy";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp N2>,
                <&macro_release>,
                <&kp LSHFT>,
                <&macro_tap>,
                <&kp G &kp I &kp F>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

        base_layer {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "BASE";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃     Q     ┃     W     ┃     F     ┃     P     ┃     G     ┃   ┃     J     ┃     L     ┃     U     ┃     Y     ┃     ;     ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃     A     ┃     R     ┃     S     ┃     T     ┃     D     ┃   ┃     H     ┃     N     ┃     E     ┃     I     ┃     O     ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃           ┃     Z     ┃     X     ┃     C     ┃     V     ┃     B     ┃   ┃     K     ┃     M     ┃     ,     ┃     .     ┃     /     ┃           ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃           ┃    TAB    ┃    SPC    ┃   ┃   ENTER   ┃   BSPC    ┃           ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
                &kp Q  &kp W  &kp F         &kp P      &kp B      &kp J      &kp L      &kp U          &kp Y    &kp SINGLE_QUOTE
                &kp A  &kp R  &kp S         &kp T      &kp G      &kp M      &kp N      &kp E          &kp I    &kp O
&kp LEFT_SHIFT  &kp Z  &kp X  &kp C         &kp D      &kp V      &kp K      &kp H      &kp COMMA      &kp DOT  &kp SLASH         &kp RIGHT_SHIFT
                              &lt 7 ESCAPE  &kp SPACE  &kp TAB    &kp ENTER  &kp SPACE  &kp BACKSPACE
            >;
        };

        left_modifiers {
            label = "MODL";
            bindings = <
            &kp LS(LG(Z))   &none             &none       &none             &kp ESC      &trans  &trans  &trans  &trans  &trans
            &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp LALT    &kp LEFT_COMMAND  &kp TAB      &trans  &trans  &trans  &trans  &trans
&caps_word  &kp LG(Z)       &kp LG(X)         &kp LG(C)   &none             &kp LG(V)    &trans  &trans  &trans  &trans  &trans  &trans
                                              &kp ESCAPE  &trans            &trans       &trans  &trans  &trans
            >;
        };

        right_modifiers {
            label = "MODR";
            bindings = <
        &trans  &trans  &trans  &trans  &trans    &kp ESCAPE  &kp RCTRL  &kp RG(X)  &kp ESC    &kp RS(RG(Z))
        &trans  &trans  &trans  &trans  &trans    &kp TAB     &kp RGUI   &kp RALT   &kp RCTRL  &kp RSHFT
&trans  &trans  &trans  &trans  &trans  &trans    &kp RG(V)   &none      &kp RG(C)  &kp RG(X)  &kp RG(Z)      &trans
                        &trans  &trans  &trans    &trans      &trans     &trans
            >;
        };

        NAV_LAYER {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "NAV";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃           ┃           ┃     UP    ┃           ┃     {     ┃   ┃     }     ┃     7     ┃     8     ┃     9     ┃     +     ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃   SHIFT   ┃   LEFT    ┃    DOWN   ┃   RIGHT   ┃     [     ┃   ┃     ]     ┃     4     ┃     5     ┃     6     ┃     -     ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃           ┃           ┃   P UP    ┃  C LOCK   ┃  P DOWN   ┃     (     ┃   ┃     )     ┃     1     ┃     2     ┃     3     ┃     *     ┃           ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃           ┃    TAB    ┃    SPC    ┃   ┃    DEL    ┃     0     ┃           ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
            &kp LS(LG(Z))   &none             &none       &none             &kp ESC      &none       &kp PG_UP      &none         &kp HOME   &none
            &kp LEFT_SHIFT  &kp LEFT_CONTROL  &kp LALT    &kp LEFT_COMMAND  &kp TAB      &caps_word  &kp LEFT       &kp UP_ARROW  &kp RIGHT  &none
&caps_word  &kp LG(Z)       &kp LG(X)         &kp LG(C)   &none             &kp LG(V)    &none       &kp PAGE_DOWN  &kp DOWN      &kp END    &none  &trans
                                              &kp ESCAPE  &trans            &trans       &trans      &trans         &kp DELETE
            >;
        };

        MOUSE_LAYER {
            label = "MOUSE";
            bindings = <
            &kp LG(LS(Z))  &none      &none       &none         &kp ESCAPE    &none       &msc SCRL_DOWN  &none           &msc SCRL_RIGHT  &none
            &kp LSHFT      &kp LCTRL  &kp LALT    &kp LEFT_GUI  &kp TAB       &caps_word  &mmv MOVE_LEFT  &mmv MOVE_UP    &mmv MOVE_RIGHT  &none
&caps_word  &kp LG(Z)      &kp LG(X)  &kp LG(C)   &none         &kp LG(V)     &none       &msc SCRL_UP    &mmv MOVE_DOWN  &msc SCRL_LEFT   &none  &trans
                                      &kp ESCAPE  &trans        &trans        &mkp LCLK   &mkp MCLK       &mkp RCLK
            >;
        };

        NUMBERS_LAYER {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "NUM";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃     !     ┃     @     ┃     #     ┃     $     ┃     %     ┃   ┃     ˆ     ┃     &     ┃     Ü     ┃     '     ┃     "     ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃     Ä     ┃           ┃    SZ     ┃           ┃           ┃   ┃   MUTE    ┃   YEN     ┃   EURO    ┃  POUND    ┃     Ö     ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃           ┃  EMAIL1   ┃  EMAIL2   ┃           ┃           ┃           ┃   ┃   VOL-    ┃   VOL+    ┃   LAST    ┃   NEXT    ┃     \     ┃           ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃           ┃    GIF    ┃    ADJ    ┃   ┃           ┃           ┃           ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
        &kp LEFT_BRACKET  &kp NUMBER_7  &kp N8        &kp N9        &kp RIGHT_BRACKET    &kp ESCAPE  &kp RCTRL  &kp RG(X)  &kp ESC    &kp RS(RG(Z))
        &kp SEMICOLON     &kp NUMBER_4  &kp N5        &kp NUMBER_6  &kp EQUAL            &kp TAB     &kp RGUI   &kp RALT   &kp RCTRL  &kp RSHFT
&trans  &kp GRAVE         &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp BACKSLASH        &kp RG(V)   &none      &kp RG(C)  &kp RG(X)  &kp RG(Z)      &trans
                                        &kp PERIOD    &kp N0        &kp MINUS            &trans      &trans     &trans
            >;
        };

        SYMBOLS_LAYER {
            label = "SYM";
            bindings = <
        &kp LEFT_BRACE  &kp AMPERSAND    &kp ASTERISK          &kp LEFT_PARENTHESIS   &kp RIGHT_BRACE    &kp ESCAPE  &none     &none      &none      &kp RG(RS(Z))
        &kp COLON       &kp DOLLAR       &kp PERCENT           &kp CARET              &kp PLUS           &kp TAB     &kp RGUI  &kp RALT   &kp RCTRL  &kp RIGHT_SHIFT
&trans  &kp TILDE       &kp EXCLAMATION  &kp AT_SIGN           &kp HASH               &kp PIPE           &kp RG(V)   &none     &kp RG(C)  &kp RG(X)  &kp RG(Z)        &trans
                                         &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDERSCORE     &trans      &trans    &trans
            >;
        };

        FUNC_LAYER {
            label = "FUNC";
            bindings = <
       &kp LG(LS(Z))  &none      &none      &none         &kp ESCAPE    &kp C_VOLUME_UP  &kp F7  &kp F8  &kp F9  &kp F12
       &kp LSHFT      &kp LCTRL  &kp LALT   &kp LEFT_GUI  &kp TAB       &kp C_VOL_DN     &kp F4  &kp F5  &kp F6  &kp F11
&none  &kp LG(Z)      &kp LG(X)  &kp LG(C)  &none         &kp LG(V)     &kp K_MUTE       &kp F1  &kp F2  &kp F3  &kp F10  &trans
                                 &trans     &trans        &trans        &trans           &trans  &trans
            >;
        };

        ADJUST_LAYER {
            // ┏━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┓

            label = "ADJ";

            // ┗━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┛
            //             ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓   ┏━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━┓
            //             ┃   RESET   ┃ BT CLEAR  ┃  OUT TOG  ┃           ┃           ┃   ┃           ┃    F7     ┃    F8     ┃    F9     ┃    F12    ┃
            //             ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫
            //             ┃ BOOTLOAD  ┃ BT NEXT   ┃           ┃           ┃           ┃   ┃           ┃    F4     ┃    F5     ┃    F6     ┃    F11    ┃
            // ┏━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┓
            // ┃           ┃           ┃ BT PREV   ┃           ┃           ┃           ┃   ┃           ┃    F1     ┃    F2     ┃    F3     ┃    F10    ┃           ┃
            // ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┫   ┣━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━╋━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛
            //                                     ┃           ┃           ┃           ┃   ┃           ┃           ┃           ┃
            //                                     ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛   ┗━━━━━━━━━━━┻━━━━━━━━━━━┻━━━━━━━━━━━┛

            bindings = <
              &sys_reset    &trans        &out OUT_TOG  &trans        &studio_unlock    &trans  &kp C_REWIND          &kp C_PLAY_PAUSE        &kp C_FAST_FORWARD                 &kp C_VOLUME_UP
              &bootloader   &trans        &trans        &trans        &trans            &trans  &kp C_AC_SEARCH       &kp C_AL_AUDIO_BROWSER  &kp C_SLEEP_MODE                   &kp C_VOLUME_DOWN
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR_ALL    &trans  &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC    &kp C_AC_DESKTOP_SHOW_ALL_WINDOWS  &kp K_MUTE         &trans
                                          &trans        &trans        &trans            &trans  &trans                &trans
            >;
        };
    };
};
